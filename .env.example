# Every variable this service reads, with a value that works against the local
# stack in deploy/. Copy it to .env and change what you need.
#
# Four of them are required and have no default: DATABASE_URL, AWS_REGION,
# OIDC_ISSUER and OIDC_AUDIENCE. Everything else here is written out at its
# default, so a line you delete changes nothing — except where a note below says
# otherwise, which is true of PUBLISHER_NAME, which has no default on purpose,
# and of HTTP_ADDR, which moves off the port Keycloak takes on a laptop.
#
# The values are read once at start-up and checked before anything is built
# from them. A variable that is set and empty counts as unset, because
# `FOO=${BAR}` in a compose file with no BAR is an empty FOO.

# --- Identity of this process -------------------------------------------------

# The name this service reports itself under, in every log line and in the
# resource attributes of every span and every measurement. It becomes
# service.name, which the collector's Prometheus exporter maps to the `job`
# label — and Prometheus renames that to `exported_job` where it collides with
# its own scrape job, which is what a dashboard has to select on.
SERVICE_NAME=wagering

# slog's own spelling: DEBUG, INFO, WARN, ERROR, or an offset such as INFO+2.
LOG_LEVEL=INFO
# json or text. JSON is the default because these lines are read by an
# aggregator far more often than by a person.
LOG_FORMAT=json

# --- Process lifecycle --------------------------------------------------------

# The outer bound on every OnStart hook together. Each dependency check —
# the database ping, the queue resolution, the JWKS fetch — is bounded again by
# its own timeout below, so a process that fails to start says which dependency
# it could not reach.
START_TIMEOUT=30s
# The outer bound on every OnStop hook together. It must be generous enough for
# the drains beneath it: the HTTP server's, then each worker's, then the pool's
# close, then the telemetry flush, which run in that order.
STOP_TIMEOUT=60s
# The budget the last hook runs under: the trace and meter providers' own
# Shutdown, which flushes whatever has not been exported yet. An exporter that
# is not answering must not hold a deployment open.
TELEMETRY_SHUTDOWN_TIMEOUT=5s

# --- OpenTelemetry ------------------------------------------------------------

# Where spans and measurements are exported, as a URL. The scheme decides
# whether the export is encrypted — http:// is plaintext gRPC, https:// is TLS —
# so there is no separate "insecure" switch and a scheme that is neither is
# refused at start-up.
#
# EMPTY MEANS NOTHING IS EXPORTED, and empty is what the service itself falls
# back to — a deliberate departure from the OpenTelemetry default of
# http://localhost:4317, because a default of "somewhere" makes a laptop, a unit
# test and a CI runner all retry a connection to a collector nobody started.
#
# The value below is not that fallback. It is the collector docker-compose.yml
# starts, seen from the host, which is where `make up` publishes it. Delete the
# value and this process exports nothing; docker-compose.yml sets the same
# variable to http://otel-collector:4317, which is the same collector from
# inside the network.
#
# The process starts normally when this names a collector that is not answering:
# the failure is logged by the SDK's error handler and nothing else changes.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# The OpenTelemetry specification's own name for "switch the SDK off". True and
# nothing is traced or measured whatever the endpoint says — the logger keeps
# working, without traceId and spanId, because there is no trace to name.
OTEL_SDK_DISABLED=false

# Bounds one attempt at exporting a batch, so an exporter that is not answering
# does not become back pressure on the thing being measured.
TELEMETRY_EXPORT_TIMEOUT=10s
# How often measurements are exported, and therefore how often the outbox lag is
# asked for — that one is observed on collection rather than recorded on a loop,
# so that a publisher whose sends are failing still reports a growing backlog.
# Thirty seconds is the right answer for a deployment. docker-compose.yml
# shortens it to five, matching that stack's Prometheus scrape interval, because
# there the interval is how long a dashboard looks empty after a transaction.
TELEMETRY_METRIC_INTERVAL=30s

# --- PostgreSQL ---------------------------------------------------------------

# Required. The role must be a member of wagering_app, which has no DDL and no
# UPDATE or DELETE on the ledger; connecting as anything else quietly removes
# half of what makes the ledger append-only. `make migrate-up` runs as the owner
# instead — see the Makefile.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wagering?sslmode=disable&options=-c%20role%3Dwagering_app

DATABASE_MAX_CONNS=10
DATABASE_CONNECT_TIMEOUT=5s
# How long a statement waits for a row lock. Short: this is ordinary contention
# on a wallet, not a query that will not finish.
DATABASE_LOCK_TIMEOUT=3s
# How long a statement may run once it is running. A different fault and a
# different budget.
DATABASE_STATEMENT_TIMEOUT=15s
DATABASE_HEALTH_TIMEOUT=2s

# --- SQS ----------------------------------------------------------------------

# Required. Resolving it from the ambient environment would let a process that
# was configured for nothing at all talk to the wrong account's queues.
AWS_REGION=us-east-1
# Where requests are sent. Empty is the real regional endpoint; this is for
# LocalStack and for nothing else.
AWS_ENDPOINT_URL=http://localhost:4566

# Credentials are NOT read by this service. They come from the AWS SDK's default
# chain — environment, profile, instance role — so nothing in this service's own
# configuration is worth stealing. LocalStack accepts any pair; a deployment
# uses an instance role and sets neither of these.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Also the SDK's, and not cosmetic on a laptop: without it the chain falls
# through to the EC2 metadata service, which is black-holed rather than refused,
# and every client costs five seconds of retries before it works.
AWS_EC2_METADATA_DISABLED=true

# The queues deploy/localstack/01-queues.sh provisions.
SQS_INBOUND_QUEUE=wager-transactions.fifo
SQS_OUTBOUND_QUEUE=wallet-events.fifo

# Bounds building the client, whose credential chain reaches the instance
# metadata service on an EC2 host.
SQS_CLIENT_TIMEOUT=10s
# Bounds turning a queue name into its URL at start-up, which is the check that
# makes a queue nobody provisioned a start-up failure.
SQS_RESOLVE_TIMEOUT=5s
# 1 to 10.
SQS_MAX_MESSAGES=10
# Whole seconds, at most 20. Anything shorter is a consumer paying for empty
# receives on an idle queue.
SQS_WAIT_TIME=20s
# Whole seconds. This is the queues' own provisioned value, restated because the
# consumer's drain timeout has to stay under it.
SQS_VISIBILITY_TIMEOUT=30s
SQS_HEALTH_TIMEOUT=2s
# The queues' redrive policy, so the consumer can say when a delivery is the
# last one before the dead-letter queue. It must match 01-queues.sh; 0 would
# mean the consumer says nothing about it.
SQS_MAX_RECEIVE_COUNT=5

# --- OpenID Connect -----------------------------------------------------------

# Required, and compared with a token's "iss" byte for byte. No trailing slash:
# the verifier does not normalise, and two spellings of one issuer would both be
# accepted here while the realm only ever mints one of them.
OIDC_ISSUER=http://localhost:8080/realms/wagering
# Required, and must appear in a token's "aud". Keycloak does not put an API's
# own identifier there for a client_credentials grant unless the realm says so
# with an audience mapper.
OIDC_AUDIENCE=wagering-api
# Empty means discovery through the issuer's OpenID configuration document. Set
# it where the issuer a token names and the address this process can reach it at
# are not the same string — a container published on a mapped port, usually.
OIDC_JWKS_URI=
# The signature allow-list, by JOSE name, comma separated. Empty means every
# asymmetric family the adapter knows. A symmetric algorithm or "none" is
# refused at construction, so an allow-list that could not close the confusion
# attack cannot be built.
OIDC_ALGORITHMS=
OIDC_CLOCK_SKEW=30s
# Bounds one attempt at obtaining the key set, including the start-up fetch that
# decides whether this process starts at all.
OIDC_FETCH_TIMEOUT=5s
# The shortest gap between two fetches, which keeps a stream of invented key
# identifiers from becoming an amplifier pointed at the identity provider.
OIDC_MIN_REFRESH_INTERVAL=1m
# The timeout of the client that fetches keys. The adapter requires a client
# rather than sharing http.DefaultClient, which has no timeout at all.
OIDC_HTTP_TIMEOUT=5s

# --- HTTP server (cmd/api) ----------------------------------------------------

# The default is :8080. It is moved here because the local Keycloak answers on
# 8080 and OIDC_ISSUER above names it; in compose they are separate containers
# and both can have the port.
HTTP_ADDR=:8081
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# How long the server waits for requests in flight when it is asked to stop.
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_BODY_BYTES=1048576
# Bounds the whole readiness probe, not each check in it.
HTTP_READINESS_TIMEOUT=3s

# --- The wait budget an operation gets for a reference it depends on ----------

# When a parked operation is looked at again. The domain's schedule, not a
# worker's: it is kept apart from the budget below so that tuning it cannot
# change whether an operation is eventually settled.
WAGERING_BACKOFF_INITIAL=1s
WAGERING_BACKOFF_FACTOR=2
WAGERING_BACKOFF_MAX=1m

# How many times an operation may be parked, and how long after the first wait
# it stops waiting. Whichever runs out first settles it — rejected for the
# reference it waited for, with a row and an event.
REFERENCE_MAX_ATTEMPTS=20
REFERENCE_TTL=5m

# --- The consumer (cmd/worker) ------------------------------------------------

CONSUMER_ENABLED=true
# This MUST be identical across every replica. The inbox holds one row per
# consumer per message, and that row is what turns a redelivery into a replay;
# a name derived from a hostname would give each replica its own rows and let
# the same message be applied once by each of them.
CONSUMER_NAME=wager-consumer
# How many messages one instance handles at once, as that many independent
# receivers. Ordering within a wallet is SQS's to keep, not this number's.
CONSUMER_CONCURRENCY=4
CONSUMER_BACKOFF_INITIAL=2s
CONSUMER_BACKOFF_FACTOR=2
CONSUMER_BACKOFF_MAX=1m
# Keep it under SQS_VISIBILITY_TIMEOUT, so that a message given back at shutdown
# is given back with a receipt handle that is still worth something.
CONSUMER_DRAIN_TIMEOUT=20s

# --- The outbox publisher (cmd/worker) ----------------------------------------

PUBLISHER_ENABLED=true
# This MUST be distinct per process — the opposite of CONSUMER_NAME, for the
# opposite reason. It lands in outbox.claimed_by and scopes a reschedule to the
# publisher holding the row, so two publishers sharing a name put back each
# other's claims. There is no default: unset, HOSTNAME is used, which a
# container runtime sets to something distinct per replica; with neither set the
# process refuses to start.
PUBLISHER_NAME=publisher-local
# At most 10, which is what one SendMessageBatch carries.
PUBLISHER_BATCH=10
# How long a claim stands before another publisher may take the row.
PUBLISHER_HOLD=30s
# How long an idle publisher waits before claiming again. A turn that filled its
# batch does not wait.
PUBLISHER_INTERVAL=1s
PUBLISHER_BACKOFF_INITIAL=2s
PUBLISHER_BACKOFF_FACTOR=2
PUBLISHER_BACKOFF_MAX=5m
PUBLISHER_DRAIN_TIMEOUT=20s

# --- The reference worker (cmd/worker) ----------------------------------------

REFERENCE_WORKER_ENABLED=true
# The subject the service principal acts under, kept for the audit trail and
# never for a decision. Stable rather than per-process, so a row's trail names
# the job and not the pod that happened to run it.
REFERENCE_WORKER_NAME=reference-worker
# How long the loop waits when nothing was due. A turn that carried an operation
# forward does not wait.
REFERENCE_WORKER_INTERVAL=1s
REFERENCE_WORKER_BACKOFF_INITIAL=2s
REFERENCE_WORKER_BACKOFF_FACTOR=2
REFERENCE_WORKER_BACKOFF_MAX=1m
REFERENCE_WORKER_DRAIN_TIMEOUT=20s

# --- The local stack, which is not this service -------------------------------
#
# Nothing below is read by the API or the worker. These are read by the
# Makefile, which takes them from the environment when they are set and falls
# back to exactly these values when they are not — so `make dashboards` and
# `make trace` describe the stack docker-compose.yml brings up, and a password
# that a target prints is written down somewhere other than that target.

# Grafana, with both datasources and the dashboard provisioned: it comes up with
# "Wagering service" already loaded and nothing to import. Anonymous access is
# on, so opening the URL is enough to read it; these credentials are what
# anything that writes has to present, and they are docker-compose.yml's
# GF_SECURITY_ADMIN_USER and GF_SECURITY_ADMIN_PASSWORD — placeholders, on a
# stack reachable from nowhere but this laptop.
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Tempo's API, which is what answers `make trace CORRELATION=...` — the trace
# behind one correlationId, request span and published-event spans together.
TEMPO_URL=http://localhost:3200
